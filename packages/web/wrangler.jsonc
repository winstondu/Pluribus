// Pluribus is served as static assets only: the backend runs in the browser's
// Web Worker and calls model providers directly, so there is no Worker script.
// Build first (`pnpm build`), then `pnpm run deploy`. See docs/build/deploy.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pluribus",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "pluribus.winstondu.com", "custom_domain": true }],
  // Only the custom domain serves the app.
  "workers_dev": false,
  "preview_urls": false
}
